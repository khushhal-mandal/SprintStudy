# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Postgres ---
# Used by the db service and composed into DATABASE_URL below.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Where the API reaches Postgres. Inside compose the host is the service name,
# "db"; from the host machine it is localhost.
#   postgresql://USER:PASSWORD@db:5432/DB
DATABASE_URL=

# --- LLM ---
# https://console.groq.com/keys
# Only needed for answering and quiz generation; ingestion and retrieval are
# offline. A missing key surfaces as a 503 naming the cause, not a crash.
GROQ_API_KEY=

# --- embedding ---
# Where fastembed keeps the ONNX weights. Compose mounts a volume here; deployed
# builds bake the model into the image instead and point at the same path.
EMBED_CACHE_DIR=

# --- retrieval backend ---
# numpy reads data/*.npy, postgres reads the chunks table. numpy is the
# reference implementation; both produce identical rankings.
STORE=
